# Clés API (obligatoires)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Clé Gemini : à créer sur Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini - gemini-3.6-flash recommandé (dernier Flash "Stable")
# Autres options :
# - gemini-3.8-flash : plus récent, mais pas encore "Stable"
# - gemini-3.1-pro-preview : modèle Pro (preview), plus lent et plus cher
GEMINI_MODEL=gemini-3.6-flash

# Loopback audio (OTHER) : détecté automatiquement à partir du périphérique
# de sortie par défaut de Windows. Mets ton casque / la sortie utilisée par
# Teams comme sortie par défaut dans les paramètres son de Windows.
# `python -m backend.audio_devices` liste les devices (diagnostic uniquement).
# Note: Le micro est capturé directement par le navigateur

# Langue au démarrage: fr ou en
DEFAULT_LANGUAGE=fr
