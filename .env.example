# Clés API (obligatoires)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Clé Gemini : à créer sur Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini - gemini-3.6-flash recommandé (dernier Flash "Stable")
# Autres options :
# - gemini-3.8-flash : plus récent, mais pas encore "Stable"
# - gemini-3.1-pro-preview : modèle Pro (preview), plus lent et plus cher
GEMINI_MODEL=gemini-3.6-flash

# Niveau de réflexion ("thinking") des suggestions et du chat : minimal, low, medium ou high.
# low (défaut) divise environ par deux la latence par rapport au niveau par défaut du modèle (medium).
# Valeur invalide : ignorée (niveau par défaut du modèle). Le classifieur utilise toujours minimal.
GEMINI_THINKING_LEVEL=low

# Modèle léger utilisé par la réponse automatique pour confirmer qu'OTHER
# vient de poser une question (rapide et peu coûteux)
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite

# Réponse automatique au démarrage : true/1/yes = activée, sinon désactivée.
# Quand elle est activée, les suggestions sont générées dès qu'OTHER termine
# une question qui t'est adressée (activable aussi depuis l'interface).
AUTO_ANSWER=false

# Loopback audio (OTHER) : détecté automatiquement à partir du périphérique
# de sortie par défaut de Windows. Mets ton casque / la sortie utilisée par
# Teams comme sortie par défaut dans les paramètres son de Windows.
# `python -m backend.audio_devices` liste les devices (diagnostic uniquement).
# Note: Le micro est capturé directement par le navigateur

# Langue au démarrage: fr ou en
DEFAULT_LANGUAGE=fr
