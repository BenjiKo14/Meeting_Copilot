# Clés API (obligatoires)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Modèle OpenAI - gpt-4o recommandé pour éviter les hallucinations
# gpt-4o-mini est moins cher mais peut inventer des infos
# gpt-4o est plus fiable et suit mieux les instructions
OPENAI_MODEL=gpt-4o

# Sélection du device loopback (Teams audio). Valeur possible:
# - index numérique (ex: 3)
# - ou sous-chaîne du nom (ex: "Headset")
# Utilise `python -m backend.audio_devices` pour lister les devices
# Note: Le micro est capturé directement par le navigateur
LOOPBACK_DEVICE=

# Langue au démarrage: fr ou en
DEFAULT_LANGUAGE=fr
